{
  "info": {
    "name": "messaging-event-gateway",
    "description": "Collection de casos de uso para el Messaging Event Gateway en local. Variable `baseUrl` por defecto a http://localhost:8080.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "publishToken",
      "value": "REPLACE_WITH_PUBLISH_TOKEN",
      "type": "string",
      "description": "Token devuelto al crear el topic (POST /topics). Usado en X-Topic-Token al publicar, actualizar topic y schema-validation."
    },
    {
      "key": "subToken",
      "value": "REPLACE_WITH_SUB_TOKEN",
      "type": "string",
      "description": "Token de la sub PULL pago-reintegros (POST /subscriptions sobre solicitudes-reintegros). Usado en X-Sub-Token al consumir y actualizar sub PULL."
    },
    {
      "key": "subTokenAltoMonto",
      "value": "REPLACE_WITH_SUB_TOKEN",
      "type": "string",
      "description": "Token de la sub PULL pago-reintegros-alto-monto (POST /subscriptions sobre solicitudes-reintegros-alto-monto)."
    },
    {
      "key": "pushSubToken",
      "value": "REPLACE_WITH_PUSH_SUB_TOKEN",
      "type": "string",
      "description": "Token de la sub PUSH pago-reintegros-push (POST create). Usado en conf-resilience PUT/DELETE."
    }
  ],
  "item": [
    {
      "name": "Crear topic solicitudes-reintegros v1",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"id\": \"solicitudes-reintegros\",\n    \"version\": 1,\n    \"description\": \"Topic principal para publicar pedidos de reintegros\",\n    \"ownerApp\": \"finanzas-api\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/topics",
          "host": ["{{baseUrl}}"],
          "path": ["topics"]
        }
      },
      "response": []
    },
    {
      "name": "Leer topicos",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/topics",
          "host": ["{{baseUrl}}"],
          "path": ["topics"]
        }
      },
      "response": []
    },
    {
      "name": "Crear subscripcion a solicitudes-reintegros",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"topicId\": \"solicitudes-reintegros\",\n    \"topicVersion\": 1,\n    \"nameSub\": \"pago-reintegros\",\n    \"description\": \"procesador de reintegros por PULL\",\n    \"type\": \"PULL\",\n    \"urlRest\": null,\n    \"maxRetries\": 10\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/subscriptions",
          "host": ["{{baseUrl}}"],
          "path": ["subscriptions"]
        }
      },
      "response": []
    },
    {
      "name": "Crear subscripcion PUSH a solicitudes-reintegros",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"topicId\": \"solicitudes-reintegros\",\n    \"topicVersion\": 1,\n    \"nameSub\": \"pago-reintegros-push\",\n    \"description\": \"procesador de reintegros por PUSH\",\n    \"type\": \"PUSH\",\n    \"urlRest\": \"http://host.docker.internal:8181/ws.reintegros/pagos\",\n    \"maxRetries\": 10\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/subscriptions",
          "host": ["{{baseUrl}}"],
          "path": ["subscriptions"]
        }
      },
      "response": []
    },
    {
      "name": "Leer subscripciones del topico solicitudes-reintegros",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/subscriptions?topicId=solicitudes-reintegros",
          "host": ["{{baseUrl}}"],
          "path": ["subscriptions"],
          "query": [
            {
              "key": "topicId",
              "value": "solicitudes-reintegros"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Publicar mensaje de solicitudes-reintegros",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Idempotency-Key",
            "value": "evt-006"
          },
          {
            "key": "X-Topic-Token",
            "value": "{{publishToken}}"
          },
          {
            "key": "X-Correlation-Id",
            "value": "corr-006"
          },
          {
            "key": "X-Source-App",
            "value": "finanzas-api"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"user\": \"cochis\",\n    \"eventType\": \"reintegro.solicitado\",\n    \"payload\": {\n        \"monto\": 50000,\n        \"cbu\": \"0110567620056701234560\",\n        \"du\": \"29345928\"\n    }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/topics/solicitudes-reintegros/v1/messages",
          "host": ["{{baseUrl}}"],
          "path": ["topics", "solicitudes-reintegros", "v1", "messages"]
        }
      },
      "response": []
    },
    {
      "name": "Leer mensajes subscripcion PULL pago-reintegros",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Sub-Token",
            "value": "{{subToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/subscriptions/solicitudes-reintegros-v1-pago-reintegros/messages?rows=10",
          "host": ["{{baseUrl}}"],
          "path": ["subscriptions", "solicitudes-reintegros-v1-pago-reintegros", "messages"],
          "query": [
            {
              "key": "rows",
              "value": "10"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Leer dead-letters subscripcion PUSH pago-reintegros-push",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Sub-Token",
            "value": "{{subToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/subscriptions/solicitudes-reintegros-v1-pago-reintegros-push/dead-letters?rows=10",
          "host": ["{{baseUrl}}"],
          "path": ["subscriptions", "solicitudes-reintegros-v1-pago-reintegros-push", "dead-letters"],
          "query": [
            {
              "key": "rows",
              "value": "10"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Crear topic solicitudes-reintegros-alto-monto v1",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"id\": \"solicitudes-reintegros-alto-monto\",\n    \"version\": 1,\n    \"description\": \"Topic principal para publicar pedidos de reintegros de altos montos\",\n    \"ownerApp\": \"finanzas-api\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/topics",
          "host": ["{{baseUrl}}"],
          "path": ["topics"]
        }
      },
      "response": []
    },
    {
      "name": "Crear subscripcion PULL pago-reintegros-alto-monto (solicitudes-reintegros-alto-monto)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"topicId\": \"solicitudes-reintegros-alto-monto\",\n    \"topicVersion\": 1,\n    \"nameSub\": \"pago-reintegros-alto-monto\",\n    \"description\": \"procesador de reintegros de alto monto por PULL\",\n    \"type\": \"PULL\",\n    \"urlRest\": null,\n    \"maxRetries\": 10\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/subscriptions",
          "host": ["{{baseUrl}}"],
          "path": ["subscriptions"]
        }
      },
      "response": []
    },
    {
      "name": "Leer mensajes subscripcion PULL pago-reintegros-alto-monto",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Sub-Token",
            "value": "{{subTokenAltoMonto}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/subscriptions/solicitudes-reintegros-alto-monto-v1-pago-reintegros-alto-monto/messages?rows=10",
          "host": ["{{baseUrl}}"],
          "path": ["subscriptions", "solicitudes-reintegros-alto-monto-v1-pago-reintegros-alto-monto", "messages"],
          "query": [
            {
              "key": "rows",
              "value": "10"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Crear topic pagos-reintegros v1",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"id\": \"pagos-reintegros\",\n    \"version\": 1,\n    \"description\": \"Topic para publicar eventos de reintegros pagados\",\n    \"ownerApp\": \"finanzas-api\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/topics",
          "host": ["{{baseUrl}}"],
          "path": ["topics"]
        }
      },
      "response": []
    },
    {
      "name": "Crear subscripcion PULL notificacion-pago-reintegros",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"topicId\": \"pagos-reintegros\",\n    \"topicVersion\": 1,\n    \"nameSub\": \"notificacion-pago-reintegros\",\n    \"description\": \"notificacion por mail de reintegros pagados (simulada)\",\n    \"type\": \"PULL\",\n    \"urlRest\": null,\n    \"maxRetries\": 10\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/subscriptions",
          "host": ["{{baseUrl}}"],
          "path": ["subscriptions"]
        }
      },
      "response": []
    },
    {
      "name": "Crear schema validation solicitudes-reintegros v1",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Topic-Token",
            "value": "{{publishToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"enabled\": true,\n    \"description\": \"Schema solicitud de reintegros v1\",\n    \"schema\": {\n      \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n      \"type\": \"object\",\n      \"required\": [\"monto\", \"cbu\", \"du\"],\n      \"properties\": {\n        \"monto\": {\n          \"type\": \"number\",\n          \"exclusiveMinimum\": 0\n        },\n        \"cbu\": {\n          \"type\": \"string\",\n          \"minLength\": 22,\n          \"maxLength\": 22\n        },\n        \"du\": {\n          \"type\": \"string\",\n          \"minLength\": 7,\n          \"maxLength\": 8,\n          \"pattern\": \"^[0-9]+$\"\n        }\n      },\n      \"additionalProperties\": true\n    }\n  }"
        },
        "url": {
          "raw": "{{baseUrl}}/topics/solicitudes-reintegros/v1/schema-validation",
          "host": ["{{baseUrl}}"],
          "path": ["topics", "solicitudes-reintegros", "v1", "schema-validation"]
        }
      },
      "response": []
    },
    {
      "name": "Leer schema validation solicitudes-reintegros v1",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/topics/solicitudes-reintegros/v1/schema-validation",
          "host": ["{{baseUrl}}"],
          "path": ["topics", "solicitudes-reintegros", "v1", "schema-validation"]
        }
      },
      "response": []
    },
    {
      "name": "Actualizar topic solicitudes-reintegros",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Topic-Token",
            "value": "{{publishToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"description\": \"Topic principal actualizado\",\n    \"ownerApp\": \"finanzas-api\",\n    \"maxBodyBytes\": 65536\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/topics/solicitudes-reintegros",
          "host": ["{{baseUrl}}"],
          "path": ["topics", "solicitudes-reintegros"]
        }
      },
      "response": []
    },
    {
      "name": "Actualizar subscripcion pago-reintegros",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Sub-Token",
            "value": "{{subToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"description\": \"procesador de reintegros por PULL (actualizado)\",\n    \"status\": \"ACTIVE\",\n    \"urlRest\": null,\n    \"maxDeliveryCountPull\": 10\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/subscriptions/solicitudes-reintegros-v1-pago-reintegros",
          "host": ["{{baseUrl}}"],
          "path": ["subscriptions", "solicitudes-reintegros-v1-pago-reintegros"]
        }
      },
      "response": []
    },
    {
      "name": "Actualizar conf-resilience PUSH pago-reintegros-push",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Sub-Token",
            "value": "{{pushSubToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"enabled\": true,\n    \"timeoutMs\": 2000,\n    \"retry\": {\n        \"maxAttempts\": 3,\n        \"initialBackoffMs\": 500,\n        \"multiplier\": 2.0,\n        \"maxBackoffMs\": 5000,\n        \"jitterFactor\": 0.2\n    },\n    \"circuitBreaker\": {\n        \"failureRateThreshold\": 50,\n        \"slowCallRateThreshold\": 70,\n        \"slowCallDurationMs\": 2000,\n        \"minimumNumberOfCalls\": 10,\n        \"slidingWindowSize\": 20,\n        \"waitDurationInOpenStateMs\": 30000,\n        \"permittedCallsInHalfOpenState\": 3\n    },\n    \"bulkhead\": {\n        \"maxConcurrentCalls\": 10,\n        \"maxWaitDurationMs\": 0\n    },\n    \"updatedBy\": \"postman\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/subscriptions/solicitudes-reintegros-v1-pago-reintegros-push/conf-resilience",
          "host": ["{{baseUrl}}"],
          "path": ["subscriptions", "solicitudes-reintegros-v1-pago-reintegros-push", "conf-resilience"]
        }
      },
      "response": []
    },
    {
      "name": "Reset conf-resilience PUSH pago-reintegros-push",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "X-Sub-Token",
            "value": "{{pushSubToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/subscriptions/solicitudes-reintegros-v1-pago-reintegros-push/conf-resilience",
          "host": ["{{baseUrl}}"],
          "path": ["subscriptions", "solicitudes-reintegros-v1-pago-reintegros-push", "conf-resilience"]
        }
      },
      "response": []
